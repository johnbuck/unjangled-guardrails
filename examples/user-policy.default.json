{
  "version": 1,
  "readme": [
    "Suggested-defaults policy — NEVER auto-applied. Adopt deliberately with:",
    "  unjangled-guardrails policy adopt-defaults",
    "or adopt single entries by hand with `policy add`. Review before adopting: an effect",
    "allow on a tool entry passes the brain's ask band for that tool; an effect allow on a",
    "command entry lifts the brain's asks AND denies for matching commands (the ruling",
    "semantics); a directory entry allow turns the brain's ask into an allow for calls whose",
    "argument paths all resolve under the directory (the brain still judges every call).",
    "Nothing here can touch the Always-Deny layer: secret shapes, catastrophic",
    "commands, and gate self-modification deny first, in every posture, for everyone.",
    "These entries re-emerge the operator shapes that left src/ in the 2026-10-20",
    "consolidation (de-identity pass): agent-management planes, trusted read planes,",
    "workflow bookkeeping, doc-tree writes, everyday git, and throwaway build trees.",
    "Every install is different — delete what does not match yours."
  ],
  "entries": [
    { "kind": "tool", "pattern": "paseo_*", "effect": "allow", "reason": "agent-management plane: managing agents touches no code, files or credentials; each agent's own gate judges its work" },
    { "kind": "tool", "pattern": "mcp__paseo__*", "effect": "allow", "reason": "the same plane, the MCP-prefixed spelling some harnesses deliver" },
    { "kind": "tool", "pattern": "sendmessage", "effect": "allow", "reason": "agent coordination" },
    { "kind": "tool", "pattern": "send_agent_prompt", "effect": "allow", "reason": "agent coordination" },
    { "kind": "tool", "pattern": "respond_to_permission", "effect": "allow", "reason": "agent coordination" },
    { "kind": "tool", "pattern": "get_agent_status", "effect": "allow", "reason": "agent coordination" },
    { "kind": "tool", "pattern": "list_pending_permissions", "effect": "allow", "reason": "agent coordination" },
    { "kind": "tool", "pattern": "listagents", "effect": "allow", "reason": "agent coordination" },
    { "kind": "tool", "pattern": "taskstop", "effect": "allow", "reason": "agent coordination" },
    { "kind": "tool", "pattern": "agent", "effect": "allow", "reason": "agent coordination" },
    { "kind": "tool", "pattern": "croncreate", "effect": "allow", "reason": "schedule management" },
    { "kind": "tool", "pattern": "crondelete", "effect": "allow", "reason": "schedule management" },
    { "kind": "tool", "pattern": "cronlist", "effect": "allow", "reason": "schedule management" },
    { "kind": "tool", "pattern": "schedulewakeup", "effect": "allow", "reason": "schedule management" },

    { "kind": "tool", "pattern": "mcp__cognee", "effect": "allow", "reason": "trusted memory/search plane" },
    { "kind": "tool", "pattern": "mcp__uptime-kuma", "effect": "allow", "reason": "trusted monitoring plane" },
    { "kind": "tool", "pattern": "mcp__scrapling", "effect": "allow", "reason": "trusted fetch plane" },
    { "kind": "tool", "pattern": "mcp__serena", "effect": "allow", "reason": "trusted code-intel plane" },
    { "kind": "tool", "pattern": "mcp__email-mcp__send_email", "effect": "ask", "reason": "sends always prompt — the harness approval layers are not reliable enough to hold this" },

    { "kind": "command", "pattern": "uv run *_bmad/scripts/*.py", "effect": "allow", "scope": "global", "reason": "workflow script family (the BMAD-method bookkeeping scripts)" },
    { "kind": "command", "pattern": "python*_bmad/scripts/*.py", "effect": "allow", "scope": "global", "reason": "workflow script family, the interpreter spelling" },
    { "kind": "command", "pattern": "*skills/bmad*/scripts/*.py", "effect": "allow", "scope": "global", "reason": "workflow skill scripts" },
    { "kind": "command", "pattern": "git add *_bmad-output*", "effect": "allow", "scope": "global", "reason": "bookkeeping commits confined to the workflow artifact tree" },
    { "kind": "command", "pattern": "git commit *_bmad-output*", "effect": "allow", "scope": "global", "reason": "bookkeeping commits confined to the workflow artifact tree" },

    { "kind": "command", "pattern": "*_bmad-output/*", "effect": "allow", "tool": "write", "scope": "global", "reason": "workflow artifact writes (plans, evidence, memlogs)" },
    { "kind": "command", "pattern": "*_bmad-output/*", "effect": "allow", "tool": "edit", "scope": "global", "reason": "workflow artifact edits" },
    { "kind": "command", "pattern": "*.specify/*", "effect": "allow", "tool": "write", "scope": "global", "reason": "spec-tree writes" },
    { "kind": "command", "pattern": "*.specify/*", "effect": "allow", "tool": "edit", "scope": "global", "reason": "spec-tree edits" },
    { "kind": "command", "pattern": "*/docs/*", "effect": "allow", "tool": "write", "scope": "global", "reason": "documentation writes" },
    { "kind": "command", "pattern": "*/docs/*", "effect": "allow", "tool": "edit", "scope": "global", "reason": "documentation edits" },
    { "kind": "command", "pattern": "*/evidence/*", "effect": "allow", "tool": "write", "scope": "global", "reason": "evidence writes (claims ship with their artifacts)" },
    { "kind": "command", "pattern": "*/evidence/*", "effect": "allow", "tool": "edit", "scope": "global", "reason": "evidence edits" },

    { "kind": "command", "pattern": "git status", "effect": "allow", "scope": "global", "reason": "everyday git, read-only trio" },
    { "kind": "command", "pattern": "git diff*", "effect": "allow", "scope": "global", "reason": "everyday git, read-only trio" },
    { "kind": "command", "pattern": "git log*", "effect": "allow", "scope": "global", "reason": "everyday git, read-only trio" },
    { "kind": "command", "pattern": "git show*", "effect": "allow", "scope": "global", "reason": "everyday git, read-only trio" },
    { "kind": "command", "pattern": "git branch", "effect": "allow", "scope": "global", "reason": "branch listing" },
    { "kind": "command", "pattern": "git checkout -b *", "effect": "allow", "scope": "global", "reason": "create-branch only; a bare checkout discards work and stays brain-side" },
    { "kind": "command", "pattern": "git switch -c *", "effect": "allow", "scope": "global", "reason": "create-branch only" },
    { "kind": "command", "pattern": "git stash*", "effect": "allow", "scope": "global", "reason": "stash family (reflog-recoverable)" },
    { "kind": "command", "pattern": "git commit -m *", "effect": "allow", "scope": "global", "reason": "message-only commits of what add already gated; -a/--all and --amend stay brain-side" },
    { "kind": "command", "pattern": "git push", "effect": "allow", "scope": "global", "reason": "bare push of the current branch" },
    { "kind": "command", "pattern": "git push origin *", "effect": "allow", "scope": "global", "reason": "plain-refspec pushes; force and +refspec variants die at the Always-Deny layer before any entry is consulted" },

    { "kind": "command", "pattern": "rm -rf build/*", "effect": "allow", "scope": "global", "reason": "throwaway build trees" },
    { "kind": "command", "pattern": "rm -rf dist/*", "effect": "allow", "scope": "global", "reason": "throwaway build trees" },
    { "kind": "command", "pattern": "rm -rf out/*", "effect": "allow", "scope": "global", "reason": "throwaway build trees" },
    { "kind": "command", "pattern": "rm -rf coverage/*", "effect": "allow", "scope": "global", "reason": "throwaway build trees" },
    { "kind": "command", "pattern": "rm -rf node_modules/*", "effect": "allow", "scope": "global", "reason": "reinstallable dependency trees" },
    { "kind": "command", "pattern": "rm -rf .cache/*", "effect": "allow", "scope": "global", "reason": "regenerable caches" },
    { "kind": "command", "pattern": "rm -rf .tmp/*", "effect": "allow", "scope": "global", "reason": "project scratch" },
    { "kind": "command", "pattern": "mkdir -p .tmp/*", "effect": "allow", "scope": "global", "reason": "project scratch" },
    { "kind": "command", "pattern": "mkdir -p build/*", "effect": "allow", "scope": "global", "reason": "throwaway build trees" },
    { "kind": "command", "pattern": "mktemp*", "effect": "allow", "scope": "global", "reason": "temp files" },

    { "kind": "command", "pattern": "cat *", "effect": "allow", "scope": "global", "reason": "read utility — credential-FILE reads die at Always-Deny first, but value-shaped leaks sitting in ordinary files are brain-side and a command allow LIFTS brain denies: ship only shapes you vouch for" },
    { "kind": "command", "pattern": "ls *", "effect": "allow", "scope": "global", "reason": "read utility" },
    { "kind": "command", "pattern": "head *", "effect": "allow", "scope": "global", "reason": "read utility" },
    { "kind": "command", "pattern": "tail *", "effect": "allow", "scope": "global", "reason": "read utility" },
    { "kind": "command", "pattern": "grep *", "effect": "allow", "scope": "global", "reason": "read utility — credential-shaped operands die at Always-Deny first, but values inside ordinary files are brain-side and a command allow LIFTS brain denies: ship only shapes you vouch for" },
    { "kind": "command", "pattern": "wc *", "effect": "allow", "scope": "global", "reason": "read utility" },
    { "kind": "command", "pattern": "find *", "effect": "allow", "scope": "global", "reason": "read utility — the catastrophic find/-delete shapes die at Always-Deny first" },
    { "kind": "command", "pattern": "echo *", "effect": "allow", "scope": "global", "reason": "the operator vouches for this shape: command allow entries lift brain denies, including leak denies" },

    { "kind": "command", "pattern": "mkdir -p /tmp/*", "effect": "allow", "scope": "global", "reason": "absolute tmp scratch" },
    { "kind": "command", "pattern": "cp -r * /tmp/*", "effect": "allow", "scope": "global", "reason": "copy into tmp scratch — credential-source shapes die at Always-Deny first" },
    { "kind": "command", "pattern": "rm -rf /tmp/*", "effect": "allow", "scope": "global", "reason": "absolute tmp scratch — anchored past the slash, so bare /tmp never matches" },

    { "kind": "dir", "path": "/tmp", "effect": "allow", "reason": "transient scratch work" }
  ]
}
